# ─── Scent & Sense Backend v6.0.0 — environment template ─────────
# Copy to src/.env and fill in real values.
#   cp src/.env.example src/.env
# ─────────────────────────────────────────────────────────────────

# HTTP port. Default 3000.
PORT=3000

# NODE_ENV=production flips CORS from "dev open" to "allowlist only"
# and enables SSL for Postgres automatically. Leave blank for local dev.
NODE_ENV=production

# ─── Database ────────────────────────────────────────────────────
# Supabase: Project Settings → Database → Connection string →
# "Transaction" pooler (port 6543). Include sslmode=require.
#
# Example:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/diffuser_db?sslmode=require

# Optional: cap on connections from this backend instance.
PG_POOL_MAX=10

# ─── JWT ─────────────────────────────────────────────────────────
# Server REFUSES TO BOOT if missing or shorter than 16 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-16-chars

# ─── Device (ESP32) authentication ───────────────────────────────
# When DEVICE_TOKEN_REQUIRED=true, every firmware call to these routes:
#   GET  /api/devices/:id/state
#   PUT  /api/devices/:id/sensor
#   PUT  /api/devices/:id/hw-toggle
#   PUT  /api/devices/:id/schedule-from-hw
# must present a token (x-device-token header, body, or query param).
# Matching order:
#   1. If DEVICE_SHARED_SECRET is set and the device presents it → accept.
#   2. Otherwise compare against per-device device_token / claim_code.
DEVICE_TOKEN_REQUIRED=true
DEVICE_SHARED_SECRET=change-me-shared-device-secret

# ─── CORS ────────────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call the API.
# The mobile app sets no Origin and is always allowed.
# In production MUST be non-empty.
CORS_ALLOWED_ORIGINS=https://diffuser-backend-1.onrender.com

# ─── Firebase Admin (push notifications) ─────────────────────────
# Provide ONE of these. The code tries them in this order:
#
#   1) FIREBASE_SERVICE_ACCOUNT_JSON — the JSON content as a string.
#      Convenient for Render/Fly/Railway dashboards.
#
#   2) GOOGLE_APPLICATION_CREDENTIALS — path to the JSON file on disk.
#      On Render, use "Secret Files" to upload the JSON as
#      /etc/secrets/firebase.json, then set the path here.
#
#   3) backend/firebase-service-account.json — if you simply drop the
#      downloaded JSON into the backend/ project root (alongside
#      package.json), it will be picked up automatically. This file
#      is in .gitignore and will NOT be committed.
#
# If none of these are provided, push notifications are disabled but
# the rest of the backend continues to function normally.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# ─── Offline detection ──────────────────────────────────────────
# Mark a device offline after this many ms without a heartbeat.
DEVICE_OFFLINE_THRESHOLD_MS=180000

# Delay notifications this long after offline — cancels if device recovers.
OFFLINE_NOTIFICATION_GRACE_MS=30000

# How long the alert dedupe window is (same notification for the same device).
NOTIFICATION_DEDUPE_MINUTES=30

# ─── Logging ────────────────────────────────────────────────────
# error | warn | info | debug
LOG_LEVEL=info
