<?xml version="1.0" encoding="utf-8"?>
<!--
  FIX #2 (v5.2.5): restrict cleartext HTTP to local / dev hosts only.

  base-config               = global default for the whole app.
                              cleartextTrafficPermitted="false" means
                              any public HTTP URL (e.g. a misconfigured
                              http://... backend on the internet) is
                              refused by the OS before Dio even sees
                              it. Production talks to
                              https://diffuser-backend-1.onrender.com
                              which goes through base-config (TLS only,
                              system trust anchors).

  domain-config             = explicit cleartext allowlist. Android's
                              network-security-config does NOT support
                              CIDR in this file — we list the exact
                              LAN host(s) we actually use for
                              development plus the usual loopback
                              entries. If the dev backend moves to a
                              new LAN IP, add it here and rebuild.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <!-- Loopback + emulator hosts -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>

        <!-- Known dev-LAN backend host. Add more entries here if the
             dev backend moves. -->
        <domain includeSubdomains="false">192.168.1.106</domain>
    </domain-config>
</network-security-config>